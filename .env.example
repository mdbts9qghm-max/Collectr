# Supabase (Phase 4). Echte Werte nur in .env.local bzw. in Vercel, nie im Repo.
# Beides ist für das Frontend gedacht: Project URL und anon/publishable Key (Project Settings → API).
# Ohne diese Werte läuft die App nur lokal (ohne Login).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Push-Erinnerungen (Phase 7): nur der öffentliche VAPID-Schlüssel. Der private Schlüssel gehört ausschließlich
# in die Supabase-Function-Secrets (siehe docs/LIVEGANG.md).
VITE_VAPID_PUBLIC_KEY=
