# WHOOP — in Vercel unter Settings → Environment Variables eintragen,
# nicht in dieser Datei und nicht im Repository.
#
# Beide Werte stehen im WHOOP Developer Dashboard bei deiner App.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Die Basis-URL der App. Vercel setzt VERCEL_PROJECT_PRODUCTION_URL selbst;
# diese Variable ist nur nötig, wenn eine andere Domain gelten soll.
# Die Redirect-URI, die im Developer Dashboard eingetragen sein muss, lautet
# dann <diese URL>/api/whoop/callback
WHOOP_REDIRECT_BASE=
